@page "/Error"
@using System.Diagnostics

<PageTitle>Error | Single Buyer LSS Repository</PageTitle>

<div class="status-page">
    <div class="status-card">
        <div class="status-icon status-icon-danger" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 4 2.5 20h19z" />
                <path d="M12 10v4M12 17h.01" />
            </svg>
        </div>
        <p class="eyebrow">Single Buyer · LSS Repository</p>
        <h1>Something went wrong</h1>
        <p>An error occurred while processing your request.</p>
        @if (ShowRequestId)
        {
            <p class="muted">Request ID: <code>@RequestId</code></p>
        }
        <div class="notice notice-warning" style="text-align: left;">
            <strong>Development environment</strong>
            <p>Swapping to the <strong>Development</strong> environment will show more detailed information about this error. The Development environment should not be enabled for deployed applications because it can expose sensitive exception details to end users.</p>
        </div>
        <div class="status-actions">
            <a class="button" href="./">Return to home</a>
        </div>
    </div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
