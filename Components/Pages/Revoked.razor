@page "/revoked"
@attribute [Authorize(Policy = "SignedIn")]
<PageTitle>Access revoked | Single Buyer LSS Repository</PageTitle>

<div class="status-page">
    <div class="status-card">
        <div class="status-icon status-icon-danger" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <rect x="5" y="10" width="14" height="11" rx="2" />
                <path d="M8 10V7a4 4 0 0 1 8 0" />
                <path d="m9.5 15.5 5-4" />
            </svg>
        </div>
        <p class="eyebrow">Single Buyer · Repository access</p>
        <h1>Your LSS access has been revoked</h1>
        <p>Your Microsoft sign-in is valid, but your LSS repository access has been removed.</p>
        <p>Contact the LSS administrator if you need your access restored.</p>
        <div class="status-actions">
            <a class="button" href="access" data-enhance-nav="false">Check access status</a>
            <a class="button-outline" href="MicrosoftIdentity/Account/SignOut" data-enhance-nav="false">Sign out</a>
        </div>
    </div>
</div>
