@* Rendered by the Microsoft Identity SignedOut Razor Page, after its existing model verifies signed-out state. *@
<LayoutView Layout="typeof(MainLayout)">
    <div class="logout-landing">
        <section class="logout-overview" aria-labelledby="logout-repository-title">
            <p class="logout-kicker"><span aria-hidden="true"></span> LARGE SCALE SOLAR</p>
            <h1 id="logout-repository-title">Single Buyer<br /><span>LSS Repository</span></h1>
            <p class="logout-intro">Access solar generation data, forecasts and plant reporting.</p>
            <div class="logout-art" aria-hidden="true">
                <div class="sun"></div>
                <div class="panel panel-back"></div>
                <div class="panel"></div>
            </div>
            <div class="logout-information">
                <h2>Here when you need it</h2>
                <p>Sign back in to continue your solar generation and reporting activities.</p>
                <ul><li>Generation data</li><li>Forecasts</li><li>Plant reporting</li></ul>
            </div>
        </section>
        <section class="logout-panel" aria-labelledby="logout-title">
            <div class="logout-content">
                <div class="confirmation-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                        <circle cx="12" cy="12" r="9" />
                        <path d="m8 12 3 3 5-6" />
                    </svg>
                </div>
                <p class="logout-label">SIGNED OUT</p>
                <h2 id="logout-title">You’re signed out</h2>
                <p class="logout-description">You have signed out of the Single Buyer LSS Repository. Thank you for visiting.</p>
                <a class="logout-signin" href="MicrosoftIdentity/Account/SignIn" data-enhance-nav="false">
                    <span class="microsoft-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
                    Sign in with Microsoft <span class="arrow" aria-hidden="true">→</span>
                </a>
                <p class="logout-account">Use your authorised corporate Microsoft 365 account.</p>
                <a class="return-home" href="./">Return to home <span aria-hidden="true">→</span></a>
                <div class="logout-help">
                    <h3>Finished for now?</h3>
                    <p>You can close this tab. On a shared device, close your browser when you have finished.</p>
                </div>
            </div>
            <p class="logout-footer">Single Buyer · Large Scale Solar</p>
        </section>
    </div>
</LayoutView>

